generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ADMIN ============
model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ SETTINGS ============
model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  label String // description for admin
  type  String @default("text") // text, textarea, number, image, boolean, json
  group  String @default("general") // general, contact, social, appearance
}

// ============ BANNERS (Hero Slider) ============
model Banner {
  id          String   @id @default(cuid())
  titleAr     String
  titleEn     String   @default("")
  subtitleAr  String   @default("")
  subtitleEn  String   @default("")
  descriptionAr String @default("")
  descriptionEn String @default("")
  ctaTextAr   String   @default("")
  ctaTextEn   String   @default("")
  ctaLink     String   @default("")
  image       String   @default("")
  bgColor     String   @default("#6DB3D7")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ SERVICE CATEGORIES ============
model ServiceCategory {
  id        String   @id @default(cuid())
  nameAr    String
  nameEn    String   @default("")
  slug      String   @unique
  icon      String   @default("") // icon name or image URL
  image     String   @default("")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  services  Service[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ SERVICES / PRODUCTS ============
model Service {
  id              String   @id @default(cuid())
  nameAr          String
   nameEn          String   @default("")
  descriptionAr   String   @default("")
  descriptionEn   String   @default("")
  price           Float
   originalPrice   Float?
  image           String   @default("")
  badge           String   @default("")
  isOffer         Boolean  @default(false)
  isFeatured      Boolean  @default(false)
  isActive        Boolean  @default(true)
  categoryId      String
  category        ServiceCategory @relation(fields: [categoryId], references: [id])
  subcategoryAr   String   @default("")
  subcategoryEn   String   @default("")
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============ DOCTORS ============
model Doctor {
  id          String   @id @default(cuid())
  nameAr      String
  nameEn      String   @default("")
  specialtyAr String
  specialtyEn String   @default("")
  experienceAr String  @default("")
  experienceEn String  @default("")
  departmentAr String  @default("")
  departmentEn String  @default("")
  image       String   @default("")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ ARTICLES / NEWS ============
model Article {
  id          String   @id @default(cuid())
  titleAr     String
  titleEn     String   @default("")
  excerptAr   String   @default("")
  excerptEn   String   @default("")
  contentAr   String   @default("")
  contentEn   String   @default("")
  image       String   @default("")
  tagAr       String   @default("")
  tagEn       String   @default("")
  author      String   @default("admin")
  readTime    String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ TESTIMONIALS ============
model Testimonial {
  id        String   @id @default(cuid())
  nameAr    String
  nameEn    String   @default("")
  textAr    String
  textEn    String   @default("")
  rating    Int      @default(5)
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ BEFORE & AFTER CASES ============
model BeforeAfterCase {
  id          String   @id @default(cuid())
  doctorNameAr String
  doctorNameEn String  @default("")
  treatmentAr String
  treatmentEn String  @default("")
  categoryAr  String   @default("")
  categoryEn  String   @default("")
  branchAr    String   @default("")
  branchEn    String   @default("")
  beforeImage String
  afterImage  String
  dividerPosition Int  @default(50)
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ INSURANCE COMPANIES ============
model InsuranceCompany {
  id        String   @id @default(cuid())
  nameAr    String
  nameEn    String   @default("")
  logo      String   @default("")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ VIDEOS ============
model Video {
  id          String   @id @default(cuid())
  titleAr     String
  titleEn     String   @default("")
  thumbnail   String   @default("")
  videoUrl    String   @default("")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ PROMO POPUP ============
model PromoPopup {
  id          String   @id @default(cuid())
  titleAr     String
  titleEn     String   @default("")
  descriptionAr String @default("")
  descriptionEn String @default("")
  ctaTextAr   String   @default("")
  ctaTextEn   String   @default("")
  ctaLink     String   @default("")
  image       String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ PAGE CONTENT ============
model PageContent {
  id          String   @id @default(cuid())
  pageKey     String   @unique // e.g. "about", "contact", "terms"
  titleAr     String   @default("")
  titleEn     String   @default("")
  contentAr   String   @default("") // JSON string for sections
  contentEn   String   @default("")
  image       String   @default("")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// ============ BOOKINGS ============
model Booking {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String   @default("")
  department  String   @default("")
  doctorId    String   @default("")
  date        String   @default("")
  time        String   @default("")
  notes       String   @default("")
  amount      Float    @default(0)
  paymentStatus String @default("pending")
  stripeSessionId String? @unique
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ CONTACT MESSAGES ============
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  subject   String   @default("")
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============ JOB APPLICATIONS ============
model JobApplication {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  message   String   @default("")
  fileName  String   @default("")
  fileUrl   String   @default("")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============ RATINGS ============
model Rating {
  id            String   @id @default(cuid())
  name          String
  email         String   @default("")
  department    String   @default("")
  cleanliness   Int      @default(0)
  staffFriendly Int      @default(0)
  staffCoop     Int      @default(0)
  comment       String   @default("")
  createdAt     DateTime @default(now())
}

// ============ NAVIGATION ============
model NavItem {
  id        String   @id @default(cuid())
  labelAr   String
  labelEn   String   @default("")
  page      String   @default("")
  params    String   @default("{}") // JSON
  parentId  String?
  parent    NavItem?  @relation("NavChildren", fields: [parentId], references: [id])
  children  NavItem[] @relation("NavChildren")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
}

// ============ SOCIAL MEDIA ============
model SocialLink {
  id    String @id @default(cuid())
  platform String @unique // whatsapp, instagram, youtube, snapchat, tiktok, twitter
  url   String
  icon  String @default("")
  order Int    @default(0)
  isActive Boolean @default(true)
}

// ============ WORKING HOURS ============
model WorkingHour {
  id    String @id @default(cuid())
  dayAr String
  dayEn String @default("")
  from  String @default("")
  to    String @default("")
  order Int    @default(0)
  isActive Boolean @default(true)
}

// ============ ORDERS ============
model Order {
  id              String   @id @default(cuid())
  name            String
  email           String
  phone           String
  total           Float
  subtotal        Float
  tax             Float
  status          String   @default("pending")
  paymentStatus   String   @default("pending")
  paymentIntentId String?
  stripeSessionId String?  @unique
  items           OrderItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId String?
  nameAr    String
  nameEn    String  @default("")
  price     Float
  quantity  Int     @default(1)
  image     String  @default("")
  createdAt DateTime @default(now())
}

// ============ PAYMENTS ============
model Payment {
  id                String   @id @default(cuid())
  amount            Float
  currency          String   @default("SAR")
  status            String   @default("pending")
  paymentIntentId   String?  @unique
  stripeSessionId   String?  @unique
  customerEmail     String?
  customerName      String?
  orderId           String?
  bookingId         String?
  paymentMethod     String   @default("stripe")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}